DB_SERVER=
DB_INSTANCE=

DB_DATABASE=
DB_USER=
DB_PASSWORD=

DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=15000
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
AUTH_SESSION_SECRET=

NATIONAL_ID_HMAC_KEY=
NATIONAL_ID_ACTIVE_KEY_VERSION=
NATIONAL_ID_ENCRYPTION_KEY_V1=

# OPTIONAL. Where uploaded certificate PDFs are stored. Leave it unset and they go to
# Certificate_Storage beside the app, which is what a fresh deployment wants - nothing to configure
# on the server. Set it to move the files elsewhere, e.g. a data volume: a relative value resolves
# against the app's working directory, an absolute one (D:\TrainingPlanCertificates) is used as-is.
# Must be OUTSIDE public/ — anything under public/ is served with no authentication, and
# certificates are personal documents. A value inside public/ is refused.
# CERTIFICATE_STORAGE_ROOT=D:\TrainingPlanCertificates