        <mxCell id="edge_spine_3" value="มีในระบบ (เลือกจากรายการ)" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_3" target="node_main_4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_4" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_4" target="node_main_5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_5" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#7c3aed;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#7c3aed;" edge="1" parent="1" source="node_main_5" target="node_main_6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_6" value="หัวหน้าอนุมัติแล้ว" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_6" target="node_main_7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_7" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_7" target="node_main_8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_1" value="เป็นหัวข้อใหม่นอกระบบ:
พิมพ์ระบุหัวข้อเรื่องและเนื้อหาที่ต้องการอบรมด้วยตนเอง" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="357.5" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_1" value="เป็นหัวข้อใหม่" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#d97706;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#d97706;" edge="1" parent="1" source="node_main_3" target="node_side_1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_2" value="หัวหน้าไม่อนุมัติ:
คำขอถูกปฏิเสธ พร้อมแจ้งเหตุผลกลับไปยังพนักงาน" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="762.5" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_2" value="ไม่อนุมัติ" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#dc2626;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#dc2626;" edge="1" parent="1" source="node_main_6" target="node_side_2"><mxGeometry relative="1" as="geometry" /></mxCell>
