  <diagram id="page_25" name="25. Employee - New Activities">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="node_2" value="กิจกรรมและข่าวสาร: ติดตามภาพกิจกรรมและเวิร์กชอปพิเศษ" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="760" height="40" as="geometry" /></mxCell>
        <mxCell id="node_3" value="ติดตามข่าวการอบรม, ภาพกิจกรรมในเครือ, กิจกรรมเพื่อสังคม (CSR), และสมัครร่วมกิจกรรม" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="250" y="65" width="760" height="25" as="geometry" /></mxCell>
        <mxCell id="node_main_1" value="เริ่มดูกิจกรรม (Start)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="node_main_2" value="1. เข้าเมนู New Activities (กิจกรรมและข่าวสาร)
เปิดดูฟีดข่าวสารการฝึกอบรม กิจกรรมเวิร์กชอป และกิจกรรมเพื่อสังคม (CSR) ของทุกบริษัท" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_3" value="2. เปิดดูอัลบั้มภาพกิจกรรมการอบรม
ดูภาพบรรยากาศการเรียนรู้และการฝึกทักษะของเพื่อนพนักงานในแต่ละโรงงาน" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="350" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_4" value="มีกิจกรรมพิเศษที่
กำลังเปิดรับสมัครเข้าร่วม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="480" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="node_main_5" value="3. สมัครเข้าร่วมกิจกรรมพิเศษนอกแผน
กรอกข้อมูลยืนยันความประสงค์เข้าร่วมกิจกรรมเวิร์กชอปหรือกิจกรรม CSR" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="625" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_6" value="สิ้นสุด (End)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="755" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="edge_spine_1" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_1" target="node_main_2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_2" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#e11d48;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#e11d48;" edge="1" parent="1" source="node_main_2" target="node_main_3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_3" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#d97706;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#d97706;" edge="1" parent="1" source="node_main_3" target="node_main_4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_4" value="มีกิจกรรมเปิดรับ" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_4" target="node_main_5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_5" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_5" target="node_main_6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_1" value="ดูกิจกรรมที่ผ่านไปแล้ว:
รับชมประมวลภาพความประทับใจและผลสรุปความสำเร็จของกิจกรรม" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="487.5" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_1" value="รับชมข่าวสาร" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#64748b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#64748b;" edge="1" parent="1" source="node_main_4" target="node_side_1"><mxGeometry relative="1" as="geometry" /></mxCell>
