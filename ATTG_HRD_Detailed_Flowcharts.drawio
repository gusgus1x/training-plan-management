        <mxCell id="node_side_1" value="ข้อเขียน / อัตนัย:
ส่งเข้าหน้าจอให้อาจารย์ผู้สอนหรือผู้ประเมินตรวจและให้คะแนน" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="227.5" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_1" value="ข้อเขียน (อัตนัย)" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#d97706;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#d97706;" edge="1" parent="1" source="node_main_2" target="node_side_1"><mxGeometry relative="1" as="geometry" /></mxCell>
