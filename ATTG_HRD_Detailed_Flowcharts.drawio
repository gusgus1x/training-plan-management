  <diagram id="page_7" name="07. Plan - Training OAP">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1045" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="node_2" value="Training OAP: แผนฝึกอบรมประจำปีกลุ่มบริษัท" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="760" height="40" as="geometry" /></mxCell>
        <mxCell id="node_3" value="จัดทำแผนแม่บทประจำปี, คำนวณงบประมาณรวม, และส่งต่องบประมาณไปยังรอบอบรมอัตโนมัติ" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="250" y="65" width="760" height="25" as="geometry" /></mxCell>
        <mxCell id="node_main_1" value="เริ่มจัดทำแผนประจำปี (Start)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="node_main_2" value="1. กำหนดปีงบประมาณและเลือกคอร์ส
ระบุปีปฏิทิน, เลือกคอร์สจากฐานข้อมูล, กำหนดไตรมาส (Q1-Q4) และเดือนเป้าหมายที่จะจัด" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_3" value="2. คำนวณงบประมาณรวมของหลักสูตร
ประเมินค่าวิทยากร, ค่าอาหาร, ค่าห้องอบรม, ค่าอุปกรณ์ และสรุปต้นทุนเฉลี่ยต่อคน" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="350" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_4" value="กำหนดให้จัดสำหรับ
ทุกบริษัท หรือเฉพาะโรงงาน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="480" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="node_main_5" value="3. ระบบอัปเดตข้อมูลงบประมาณไปยังรอบอบรมให้อัตโนมัติ
ส่งต่องบประมาณและวิทยากรที่ตั้งไว้ ไปยังรุ่นต่างๆ ในแผนรายเดือน (Rolling Plan)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="625" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_6" value="4. บันทึกแผนประจำปี OAP เรียบร้อย
พร้อมนำไปแตกเป็นรุ่นปฏิบัติการจริงในแผนรายเดือน (Rolling)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="755" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_7" value="สิ้นสุด (End)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="885" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="edge_spine_1" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_1" target="node_main_2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_2" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#7c3aed;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#7c3aed;" edge="1" parent="1" source="node_main_2" target="node_main_3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_3" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#d97706;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#d97706;" edge="1" parent="1" source="node_main_3" target="node_main_4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_4" value="ทุกบริษัท (ส่วนกลางจัด)" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_4" target="node_main_5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_5" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_5" target="node_main_6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_6" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_6" target="node_main_7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_1" value="เฉพาะโรงงาน:
ระบุโรงงานเป้าหมาย (เช่น ATA, TEP, ATFB) และตัดงบเฉพาะโรงงานนั้นๆ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="487.5" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_1" value="เฉพาะโรงงาน" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#2563eb;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_4" target="node_side_1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_8" name="08. Plan - Training Rolling">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1045" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="node_2" value="Training Rolling: แผนปฏิบัติการรายเดือนและเปิดรอบอบรม" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="760" height="40" as="geometry" /></mxCell>
        <mxCell id="node_3" value="แตกแผนเป็นรุ่น (Batch), กำหนดวันเวลา/ห้องอบรม, อนุมัติแผน, และเปิดรับสมัครผ่านระบบ" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="250" y="65" width="760" height="25" as="geometry" /></mxCell>
        <mxCell id="node_main_1" value="เริ่มจัดทำแผนรายเดือน (Start)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="node_main_2" value="1. แตกแผนประจำปีเป็นรุ่นอบรม (Create Batches)
แบ่งรอบอบรมเป็นรุ่น (Batch 1, 2, 3...) ระบุวันเริ่มและวันสิ้นสุด (รองรับคอร์สหลายวัน)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_3" value="2. ระบุสถานที่, ที่นั่งรองรับ และวิทยากรจริง
กำหนดห้องอบรม, จำนวนที่นั่ง (Capacity), วิทยากรผู้สอน, และแนบข้อสอบ/แบบประเมิน" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="350" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_4" value="ตรวจสอบและอนุมัติ
แผนรอบอบรมนี้ไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="480" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="node_main_5" value="3. เปิดรับสมัครพนักงานผ่านระบบ (Published)
แสดงรอบอบรมบนปฏิทิน และเปิดให้พนักงานกดสมัครเรียนผ่านเมนู Register Train" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;fontColor=#155e75;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="625" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_6" value="4. ส่งมอบรอบอบรมเข้าสู่วันจัดจริง
ส่งต่อรายชื่อและข้อมูลรอบอบรม เพื่อเตรียมเช็คชื่อในวันเรียนจริง" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="755" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_7" value="สิ้นสุด (End)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="885" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="edge_spine_1" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_1" target="node_main_2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_2" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_2" target="node_main_3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_3" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_3" target="node_main_4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_4" value="อนุมัติแล้ว (Approved)" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_4" target="node_main_5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_5" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#0891b2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#0891b2;" edge="1" parent="1" source="node_main_5" target="node_main_6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_6" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_6" target="node_main_7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_1" value="ยังไม่อนุมัติ:
