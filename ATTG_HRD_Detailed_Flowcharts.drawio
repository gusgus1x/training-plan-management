        <mxCell id="node_side_1" value="ยังไม่มีคอร์สในระบบ:
ระบบจะพาไปสร้างคอร์สใหม่ก่อน ➔ แล้วพาไปสร้าง OAP และจัดรุ่นต่อ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="487.5" width="320" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_1" value="ยังไม่มีคอร์ส" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#dc2626;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#dc2626;" edge="1" parent="1" source="node_main_4" target="node_side_1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_2" value="มีคอร์สแล้วแต่ยังไม่มี OAP:
ระบบจะพาไปสร้างแผนประจำปี (OAP) ก่อน ➔ แล้วพากลับมาจัดรุ่นต่อ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="632.5" width="320" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_2" value="ยังไม่มี OAP" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#d97706;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#d97706;" edge="1" parent="1" source="node_main_5" target="node_side_2"><mxGeometry relative="1" as="geometry" /></mxCell>
