        <mxCell id="node_side_1" value="ยังไม่หมดอายุ / ยังเรียนไม่ครบ:
คลิกเลือกคอร์สที่เปิดรับสมัครอยู่ เพื่อไปยังหน้า Register Train สมัครเข้าเรียน" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="617.5" width="280" height="75" as="geometry" /></mxCell>
