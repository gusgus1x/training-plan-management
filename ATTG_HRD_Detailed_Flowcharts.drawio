        <mxCell id="edge_spine_4" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#d97706;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#d97706;" edge="1" parent="1" source="node_main_4" target="node_main_5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_5" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_5" target="node_main_6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_6" value="อนุมัติเรียบร้อย" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_6" target="node_main_7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_7" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_7" target="node_main_8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_8" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_8" target="node_main_9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_1" value="ยังไม่อนุมัติ / รอแก้ไข:
บันทึกเป็นแบบร่าง (Draft) เพื่อรอปรับแก้วันเวลา ห้องอบรม หรือวิทยากร" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="747.5" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_1" value="รอแก้ไข" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#64748b;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#64748b;" edge="1" parent="1" source="node_main_6" target="node_side_1"><mxGeometry relative="1" as="geometry" /></mxCell>
