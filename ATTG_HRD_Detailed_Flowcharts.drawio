  <diagram id="page_9" name="09. Plan - Request Training Need">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1060" math="0" shadow="0">
      <root>
