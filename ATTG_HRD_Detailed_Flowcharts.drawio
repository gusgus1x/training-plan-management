<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="ATTG System" pages="25">
  <diagram id="page_1" name="01. HRD - Center vs Factory">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1175" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="node_2" value="HRD: เปรียบเทียบบทบาท Center vs Factory และภาพรวมระบบ" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="760" height="40" as="geometry" /></mxCell>
        <mxCell id="node_3" value="ส่วนกลาง (Center) กำหนดมาตรฐานและงบรวม ➔ โรงงาน (Factory) ปรับใช้ในพื้นที่และส่งคนเข้าอบรม" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="250" y="65" width="760" height="25" as="geometry" /></mxCell>
        <mxCell id="node_main_1" value="เริ่มต้น (Start)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="node_main_2" value="1. กำหนดบทบาทหน้าที่ของ HRD
• HRD ส่วนกลาง (Center): ดูแลข้อมูลหลัก, สร้างคอร์สต้นแบบ, แผนประจำปีรวม, จัดสรรงบ
• HRD โรงงาน (Factory): ดึงคอร์สมาใช้, สำรวจโควตาคนในโรงงาน, จัดรอบอบรม, เบิกจ่ายงบ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_3" value="ผู้ใช้งานสังกัด
ส่วนกลาง หรือ โรงงาน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="350" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="node_main_4" value="2. ส่วนกลางสร้างคอร์สต้นแบบและแผนรวม
สร้างคอร์สมาตรฐาน ➔ ผูกข้อสอบกลาง ➔ จัดทำแผนฝึกอบรมประจำปี (OAP) และจัดสรรงบ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="495" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_5" value="3. ส่งมอบคอร์สและโควตาให้โรงงาน
เปิดให้แต่ละโรงงานดึงคอร์สไปใช้ และจัดสรรโควตาตามสายงาน" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="625" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_6" value="4. ปฏิบัติการจัดฝึกอบรมร่วมกัน
โรงงานเปิดรอบอบรมรายเดือน ➔ พนักงานสมัคร ➔ จัดสอนจริง ➔ เช็คชื่อ ➔ ตรวจข้อสอบ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="755" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_7" value="5. สรุปผลการอบรมและงบประมาณ
ตรวจสอบงบใช้จริง vs งบตามแผน, ตรวจสอบผู้ผ่านการอบรม, และออกใบประกาศนียบัตร" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="885" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_8" value="สิ้นสุดกระบวนการ (End)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="1015" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="edge_spine_1" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_1" target="node_main_2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_2" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#64748b;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#64748b;" edge="1" parent="1" source="node_main_2" target="node_main_3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_3" value="HRD ส่วนกลาง (Center)" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_3" target="node_main_4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_4" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#7c3aed;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#7c3aed;" edge="1" parent="1" source="node_main_4" target="node_main_5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_5" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_5" target="node_main_6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_6" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_6" target="node_main_7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_7" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#d97706;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#d97706;" edge="1" parent="1" source="node_main_7" target="node_main_8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_1" value="HRD โรงงาน (Factory):
ดึงคอร์สต้นแบบมาใช้ ➔ ใส่ชื่อโรงงานตนเอง ➔ สำรวจรายชื่อผู้เรียน ➔ เบิกจ่ายงบของโรงงาน" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="357.5" width="320" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_1" value="HRD โรงงาน (Factory)" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#2563eb;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_3" target="node_side_1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_2" name="02. Course - ภาพรวมการทำงาน">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1175" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="node_2" value="การจัดการหลักสูตร: ภาพรวมการทำงานทั้งโมดูล" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="760" height="40" as="geometry" /></mxCell>
        <mxCell id="node_3" value="ขั้นตอนสร้างคอร์ส: กำหนดข้อมูลคอร์ส ➔ ออกแบบข้อสอบ ➔ ออกแบบแบบประเมิน ➔ เปิดใช้งาน" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="250" y="65" width="760" height="25" as="geometry" /></mxCell>
        <mxCell id="node_main_1" value="เริ่มต้น (Start)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="node_main_2" value="1. กำหนดรายละเอียดหลักสูตร (Course Master &amp; Standard)
ตั้งรหัสคอร์ส, ชื่อคอร์ส, วัตถุประสงค์, ชั่วโมงอบรม, และกลุ่มพนักงานเป้าหมาย" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_3" value="2. ออกแบบชุดข้อสอบ (Assessment Management)
สร้างข้อสอบก่อนเรียน (Pre-test) และหลังเรียน (Post-test) พร้อมกำหนดเกณฑ์คะแนนผ่าน" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="350" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_4" value="3. ออกแบบแบบประเมิน (Evaluation Management)
สร้างแบบประเมินความพึงพอใจทันทีหลังเรียน และแบบติดตามผลหลังผ่านไป 30 วัน" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="480" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_5" value="ทดลองทำข้อสอบและ
แบบประเมินแล้ว ถูกต้องไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="610" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="node_main_6" value="4. ผูกข้อสอบและแบบประเมินเข้ากับคอร์ส
เชื่อมต่อแบบวัดผลเข้ากับหลักสูตร เพื่อให้ระบบตรวจคะแนนอัตโนมัติเมื่อพนักงานสอบ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="755" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_7" value="5. บันทึกเปิดใช้งานหลักสูตร (Active)
หลักสูตรพร้อมนำไปเปิดสอนและจัดลงในแผนการฝึกอบรม" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="885" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_8" value="สิ้นสุด (End)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="1015" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="edge_spine_1" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_1" target="node_main_2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_2" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#7c3aed;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#7c3aed;" edge="1" parent="1" source="node_main_2" target="node_main_3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_3" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#e11d48;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#e11d48;" edge="1" parent="1" source="node_main_3" target="node_main_4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_4" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#d97706;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#d97706;" edge="1" parent="1" source="node_main_4" target="node_main_5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_5" value="ถูกต้องสมบูรณ์" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_5" target="node_main_6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_6" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_6" target="node_main_7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_7" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_7" target="node_main_8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_1" value="พบจุดต้องแก้ไข:
กลับไปปรับแก้คำถาม ตัวเลือก หรือเฉลยให้ถูกต้อง" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="617.5" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_1" value="ต้องแก้ไข" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#dc2626;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#dc2626;" edge="1" parent="1" source="node_main_5" target="node_side_1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_3" name="03. Course - Master &amp; Standard">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1695" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="node_2" value="Course Master &amp; Standard: การสร้างและกำหนดมาตรฐานคอร์ส" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="760" height="40" as="geometry" /></mxCell>
        <mxCell id="node_3" value="กำหนดข้อมูลคอร์ส, เลือกคอร์สต่อเนื่องที่ต้องผ่านก่อน, กำหนดกลุ่มเป้าหมาย, และคำนวณงบต่อหัว" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="250" y="65" width="760" height="25" as="geometry" /></mxCell>
        <mxCell id="node_main_1" value="เริ่มสร้างหลักสูตร (Start)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="node_main_2" value="1. เลือกวิธีสร้างคอร์ส
ส่วนกลางสร้างคอร์สแม่แบบ หรือโรงงานดึงคอร์สแม่แบบมาปรับใช้ (Copy Template)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_3" value="2. กรอกข้อมูลพื้นฐานหลักสูตร
รหัสคอร์ส, ชื่อไทย/อังกฤษ, วัตถุประสงค์, เนื้อหาที่สอน, และหมวดหมู่คอร์ส" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="350" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_4" value="3. กำหนดรูปแบบการสอนและชั่วโมงอบรม
เลือก: ในห้องเรียน (Classroom), ออนไลน์ (Online), เวิร์กชอป, หรือฝึกหน้างาน (OJT)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="480" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_5" value="มีคอร์สต่อเนื่อง
ที่ต้องผ่านก่อนไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="610" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="node_main_6" value="4. เลือกคอร์สต่อเนื่อง (ถ้ามี)
เลือกคอร์สที่ต้องสอบผ่านก่อน โดยระบบจะช่วยตรวจสอบป้องกันไม่ให้ตั้งเงื่อนไขวนลูป" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="755" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_7" value="5. ระบุกลุ่มเป้าหมายผู้เข้าอบรม
เลือกบริษัท (ATA, TEP, etc.), สายงาน, แผนก, ตำแหน่ง, และระดับพนักงาน (L1-L9)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;fontColor=#155e75;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="885" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_8" value="6. ผูกข้อสอบและแบบประเมินผล
เลือกข้อสอบ Pre/Post Test และแบบประเมินความพึงพอใจสำหรับคอร์สนี้" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="1015" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_9" value="7. คำนวณประมาณการงบประมาณ
ประเมินค่าวิทยากร, ค่าสถานที่, ค่าอาหาร และคำนวณต้นทุนเฉลี่ยต่อคน (Cost per Head)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="1145" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_10" value="8. บันทึกเปิดใช้งานคอร์ส (Active)
หลักสูตรพร้อมเปิดรับและนำไปจัดแผนอบรมประจำปี (OAP)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="1275" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_11" value="ส่งออกโครงสร้างหลักสูตร (Course Outline Excel)
เอกสารรายละเอียดคอร์สสำหรับแนบเรื่องขออนุมัติหรือยื่นราชการ" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="1405" width="380" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_12" value="สิ้นสุด (End)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="1535" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="edge_spine_1" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_1" target="node_main_2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_2" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#7c3aed;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#7c3aed;" edge="1" parent="1" source="node_main_2" target="node_main_3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_3" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#7c3aed;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#7c3aed;" edge="1" parent="1" source="node_main_3" target="node_main_4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_4" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#64748b;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#64748b;" edge="1" parent="1" source="node_main_4" target="node_main_5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_5" value="มีคอร์สต่อเนื่อง" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_5" target="node_main_6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_6" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#d97706;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#d97706;" edge="1" parent="1" source="node_main_6" target="node_main_7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_7" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#0891b2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#0891b2;" edge="1" parent="1" source="node_main_7" target="node_main_8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_8" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#e11d48;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#e11d48;" edge="1" parent="1" source="node_main_8" target="node_main_9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_9" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#d97706;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#d97706;" edge="1" parent="1" source="node_main_9" target="node_main_10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_10" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_10" target="node_main_11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_11" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_11" target="node_main_12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_1" value="ไม่มีคอร์สต่อเนื่อง:
พนักงานทั่วไปตามกลุ่มเป้าหมายสามารถสมัครเรียนได้ทันที" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;fontColor=#155e75;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="617.5" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_1" value="ไม่มี" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#0891b2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#0891b2;" edge="1" parent="1" source="node_main_5" target="node_side_1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_4" name="04. Course - Assessment Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1305" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="node_2" value="การจัดการแบบทดสอบ: ออกแบบข้อสอบก่อนเรียนและหลังเรียน" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="760" height="40" as="geometry" /></mxCell>
        <mxCell id="node_3" value="จัดการชุดข้อสอบ, คุมเวอร์ชัน, ออกแบบคำถาม 5 รูปแบบ, ตั้งเกณฑ์ผ่าน, และตรวจคะแนนอัตโนมัติ" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="250" y="65" width="760" height="25" as="geometry" /></mxCell>
        <mxCell id="node_main_1" value="เริ่มสร้างข้อสอบ (Start)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="node_main_2" value="1. ตั้งชื่อชุดข้อสอบและจัดการเวอร์ชัน
ระบุชื่อชุดข้อสอบ, บริษัทที่ใช้, และบันทึกเวอร์ชัน (v1, v2) เมื่อมีการปรับปรุงข้อสอบ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_3" value="2. กำหนดเกณฑ์ผ่านและเวลาทำข้อสอบ
ระบุเปอร์เซ็นต์คะแนนผ่าน (เช่น 70%, 80%), กำหนดเวลาสอบ (นาที), และคำชี้แจง" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="350" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_4" value="3. ออกแบบข้อสอบ (รองรับ 5 รูปแบบ)
• ช้อยส์เลือกตอบ 1 ข้อ / ช้อยส์เลือกได้หลายข้อ / ถูก-ผิด
• ข้อเขียนสั้น-ยาว (ส่งอาจารย์ตรวจ) / ตารางจับคู่ประเมิน (Grid)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;fontColor=#155e75;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="480" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_5" value="4. ทดลองทำข้อสอบจริงเพื่อตรวจความถูกต้อง
ทดสอบทำข้อสอบเสมือนจริง ตรวจสอบการจับเวลา และเช็คความถูกต้องของเฉลยทุกข้อ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="610" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_6" value="ข้อสอบและเฉลย
ถูกต้องครบถ้วนไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="740" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="node_main_7" value="5. บันทึกเปิดใช้งานข้อสอบ (Active)
ระบบจะล็อกข้อสอบ เพื่อไม่ให้แก้ไขเฉลยระหว่างที่มีการสอบจริง" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="885" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_8" value="6. ผูกกับคอร์ส พร้อมตรวจคะแนนอัตโนมัติ
เมื่อพนักงานทำข้อสอบ ระบบจะตรวจและบันทึกคะแนนเข้าประวัติทันที" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="1015" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_9" value="สิ้นสุด (End)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="1145" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="edge_spine_1" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_1" target="node_main_2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_2" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#7c3aed;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#7c3aed;" edge="1" parent="1" source="node_main_2" target="node_main_3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_3" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#d97706;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#d97706;" edge="1" parent="1" source="node_main_3" target="node_main_4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_4" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#0891b2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#0891b2;" edge="1" parent="1" source="node_main_4" target="node_main_5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_5" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_5" target="node_main_6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_6" value="ถูกต้องสมบูรณ์" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_6" target="node_main_7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_7" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_7" target="node_main_8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_8" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_8" target="node_main_9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_1" value="พบข้อผิดพลาด:
กลับไปแก้ไขโจทย์ ตัวเลือก หรือแต้มคะแนนให้ถูกต้อง" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="747.5" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_1" value="ต้องแก้ไข" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#dc2626;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#dc2626;" edge="1" parent="1" source="node_main_6" target="node_side_1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_5" name="05. Course - Evaluation Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="node_2" value="การจัดการแบบประเมิน: ประเมินผลการอบรมและติดตามผล 30 วัน" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="760" height="40" as="geometry" /></mxCell>
        <mxCell id="node_3" value="แบบประเมินมาตรฐานและแบบประเมิน 19 ข้อ ➔ แบ่งหน้า/เงื่อนไข ➔ คำนวณความพึงพอใจ ➔ ส่งออกรายงาน" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="250" y="65" width="760" height="25" as="geometry" /></mxCell>
        <mxCell id="node_main_1" value="เริ่มสร้างแบบประเมิน (Start)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="node_main_2" value="เลือกช่วงเวลา
ที่จะให้ทำแบบประเมิน?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="220" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="node_main_3" value="1. ออกแบบข้อคำถามในแบบฟอร์ม (2 รูปแบบ)
• แบบประเมินทั่วไป: ดาว 1-5, ตัวเลือก, ตารางหัวข้อย่อย และข้อเสนอแนะ
• แบบประเมินองค์กร 19 ข้อ: Part 1 ทั่วไป, Part 2 หลักสูตร, Part 3 วิทยากร, Part 4 ข้อคิดเห็น" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="365" width="480" height="95" as="geometry" /></mxCell>
        <mxCell id="node_main_4" value="2. แบ่งหน้าและตั้งเงื่อนไขข้ามหน้า (ถ้ามี)
ใส่ข้อความชี้แจง และตั้งค่าให้ข้ามไปยังหน้าที่ต้องการตามคำตอบที่ผู้เรียนเลือก" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;fontColor=#155e75;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="515" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_5" value="3. ทดลองตอบแบบประเมินจริง
ตรวจเช็คหน้าตาฟอร์ม การแบ่งหน้า และความถูกต้องของคำถาม" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="645" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_6" value="ฟอร์มประเมิน
พร้อมเปิดใช้งานไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="775" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="node_main_7" value="4. เปิดใช้งานแบบประเมิน และผูกเข้ากับรอบอบรม
เปิดให้พนักงานที่เข้าอบรมทำแบบประเมินหลังเรียนจบผ่านหน้าเว็บหรือสแกน QR Code" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="920" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_8" value="5. ประมวลผลคะแนน &amp; แปลงผลประเมิน (Section Converter)
คำนวณร้อยละความพึงพอใจภาพรวม พร้อมรวบรวมข้อคิดเห็น Part 4 ส่งต่อผู้เกี่ยวข้อง" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="1050" width="480" height="85" as="geometry" /></mxCell>
        <mxCell id="node_main_9" value="ส่งออกรายงานสรุปผลประเมิน (Evaluation Report Excel)
รายงานสรุปคะแนนความพึงพอใจ จำแนกตามหมวด และรายงานข้อคิดเห็นส่งผู้บริหาร" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.18;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="1190" width="380" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_10" value="สิ้นสุด (End)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="1320" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="edge_spine_1" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_1" target="node_main_2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_2" value="ทำทันทีหลังอบรมเสร็จ" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_2" target="node_main_3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_3" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_3" target="node_main_4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_4" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#0891b2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#0891b2;" edge="1" parent="1" source="node_main_4" target="node_main_5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_5" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#7c3aed;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#7c3aed;" edge="1" parent="1" source="node_main_5" target="node_main_6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_6" value="พร้อมเปิดใช้งาน" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_6" target="node_main_7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_7" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#16a34a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#16a34a;" edge="1" parent="1" source="node_main_7" target="node_main_8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_8" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#7c3aed;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#7c3aed;" edge="1" parent="1" source="node_main_8" target="node_main_9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_spine_9" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_9" target="node_main_10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_1" value="ติดตามผลหลังอบรม 30-90 วัน:
แบบประเมินวัดการนำความรู้ไปใช้จริงในการทำงาน (ประเมินโดยตนเองและหัวหน้างาน)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="227.5" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_1" value="ติดตามผล 30 วัน" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#d97706;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#d97706;" edge="1" parent="1" source="node_main_2" target="node_side_1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="node_side_2" value="ยังไม่พร้อม:
บันทึกเป็นแบบร่าง (Draft) เพื่อรอตรวจทานหัวข้อคำถาม" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#e11d48;fontColor=#881337;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="950" y="782.5" width="280" height="75" as="geometry" /></mxCell>
        <mxCell id="edge_side_2" value="ยังไม่พร้อม" style="edgeStyle=straight;html=1;strokeWidth=2;strokeColor=#dc2626;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#dc2626;" edge="1" parent="1" source="node_main_6" target="node_side_2"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page_6" name="06. Plan - ภาพรวมการทำงาน">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1305" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="node_2" value="การจัดการแผนฝึกอบรม: ภาพรวมการทำงานทั้งโมดูล" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="760" height="40" as="geometry" /></mxCell>
        <mxCell id="node_3" value="ขั้นตอนวางแผน: รับคำขอ ➔ สำรวจโควตา ➔ แผนประจำปี (OAP) ➔ แผนรายเดือน (Rolling) ➔ เปิดรับสมัคร" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="250" y="65" width="760" height="25" as="geometry" /></mxCell>
        <mxCell id="node_main_1" value="เริ่มต้น (Start)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="120" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="node_main_2" value="1. รับคำขอฝึกอบรม (Request Training Need)
รับเรื่องจากแผนก/พนักงานที่ต้องการอบรม และตรวจสอบความต้องการตามหลักสูตร" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="220" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_3" value="2. สำรวจและอนุมัติรายชื่อ (Training Accept Survey)
ดึงกลุ่มเป้าหมายตามมาตรฐานคอร์ส ตรวจสอบโควตา และอนุมัติรายชื่อผู้เข้าอบรม" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="350" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_4" value="3. จัดทำแผนประจำปี (Training OAP)
วางแผนงบประมาณภาพรวมของกลุ่มบริษัท กำหนดไตรมาสและเดือนเป้าหมายที่จะจัด" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="480" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_5" value="4. จัดทำแผนปฏิบัติการรายเดือน (Training Rolling)
แตกแผนเป็นรุ่น (Batches) ระบุวันเวลา ห้องอบรม วิทยากร และจำนวนที่นั่ง" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="610" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_6" value="แผนรอบอบรมได้รับ
การอนุมัติเรียบร้อยไหม?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="740" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="node_main_7" value="5. เปิดรับสมัครในระบบ
แสดงบนปฏิทิน และเปิดให้พนักงานกดสมัครเรียนผ่านเมนู Register Train" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="885" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_8" value="6. ส่งรอบอบรมเข้าสู่วันจัดจริง
ส่งมอบข้อมูลรอบอบรมเพื่อเตรียมพร้อมสำหรับการเช็คชื่อในวันเรียนจริง" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=12;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="350" y="1015" width="480" height="75" as="geometry" /></mxCell>
        <mxCell id="node_main_9" value="สิ้นสุด (End)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="1145" width="220" height="45" as="geometry" /></mxCell>
        <mxCell id="edge_spine_1" value="" style="edgeStyle=straight;html=1;strokeWidth=2.5;strokeColor=#2563eb;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;rounded=0;endArrow=classic;endFill=1;endSize=7;labelBackgroundColor=#ffffff;labelBorderColor=none;fontSize=11;fontStyle=1;fontColor=#2563eb;" edge="1" parent="1" source="node_main_1" target="node_main_2"><mxGeometry relative="1" as="geometry" /></mxCell>
