  target_company_id      BigInt                 @id(map: "PK_course_standard_target_company") @default(autoincrement())
  standard_course_id     BigInt
  company_id             BigInt
  company                company                @relation(fields: [company_id], references: [company_id], onUpdate: NoAction, map: "FK_course_standard_target_company_company_id")
  course_standard_course course_standard_course @relation(fields: [standard_course_id], references: [standard_course_id], onDelete: Cascade, onUpdate: NoAction, map: "FK_course_standard_target_company_standard_course_id")

  @@unique([standard_course_id, company_id], map: "UQ_standard_course_target_company")
}

model company_department_mapping {
  department_mapping_id BigInt     @id(map: "PK_company_department_mapping") @default(autoincrement())
  company_id            BigInt
  plant_department_code String     @db.NVarChar(50)
  plant_department_name String     @db.NVarChar(255)
  department_id         BigInt
  status                String     @db.NVarChar(20)
  company               company    @relation(fields: [company_id], references: [company_id], onUpdate: NoAction, map: "FK_company_department_mapping_company_company_id")
  department            department @relation(fields: [department_id], references: [department_id], onUpdate: NoAction, map: "FK_company_department_mapping_department_department_id")

  @@unique([company_id, plant_department_code], map: "UQ_company_department_mapping_company_id_plant_department_code")
  @@index([department_id], map: "IX_company_department_mapping_department_id")
}

model company_division_mapping {
  division_mapping_id BigInt   @id(map: "PK_company_division_mapping") @default(autoincrement())
  company_id          BigInt
  plant_division_code String   @db.NVarChar(50)
  plant_division_name String   @db.NVarChar(255)
  division_id         BigInt
  status              String   @db.NVarChar(20)
  company             company  @relation(fields: [company_id], references: [company_id], onUpdate: NoAction, map: "FK_company_division_mapping_company_company_id")
  division            division @relation(fields: [division_id], references: [division_id], onUpdate: NoAction, map: "FK_company_division_mapping_division_division_id")

  @@unique([company_id, plant_division_code], map: "UQ_company_division_mapping_company_id_plant_division_code")
  @@index([division_id], map: "IX_company_division_mapping_division_id")
}

model company_section_mapping {
  section_mapping_id BigInt  @id(map: "PK_company_section_mapping") @default(autoincrement())
  company_id         BigInt
  plant_section_code String  @db.NVarChar(50)
  plant_section_name String  @db.NVarChar(255)
  section_id         BigInt
  status             String  @db.NVarChar(20)
  company            company @relation(fields: [company_id], references: [company_id], onUpdate: NoAction, map: "FK_company_section_mapping_company_company_id")
  section            section @relation(fields: [section_id], references: [section_id], onUpdate: NoAction, map: "FK_company_section_mapping_section_section_id")

  @@unique([company_id, plant_section_code], map: "UQ_company_section_mapping_company_id_plant_section_code")
  @@index([section_id], map: "IX_company_section_mapping_section_id")
}

model audit_log {
  audit_log_id   BigInt   @id(map: "PK_audit_log") @default(autoincrement())
  occurred_at    DateTime
  category       String   @db.NVarChar(20)
  action         String   @db.NVarChar(60)
  actor_user_id  BigInt?
  actor_username String?  @db.NVarChar(100)
  actor_role     String?  @db.NVarChar(30)
  entity_type    String?  @db.NVarChar(60)
  entity_id      String?  @db.NVarChar(50)
  entity_label   String?  @db.NVarChar(255)
  detail         String?  @db.NVarChar(Max)
  ip_address     String?  @db.NVarChar(45)
  user_agent     String?  @db.NVarChar(400)
  retain_until   DateTime @db.Date

  @@index([actor_user_id], map: "IX_audit_log_actor_user_id")
  @@index([category, occurred_at(sort: Desc)], map: "IX_audit_log_category_occurred_at")
  @@index([occurred_at(sort: Desc)], map: "IX_audit_log_occurred_at")
  @@index([retain_until], map: "IX_audit_log_retain_until")
}
