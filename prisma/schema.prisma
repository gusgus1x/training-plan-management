  @@index([employee_id], map: "IX_training_record_request_employee_id")
  @@index([exported_by], map: "IX_training_record_request_exported_by")
  @@index([function_id], map: "IX_training_record_request_function_id")
  @@index([reviewed_by], map: "IX_training_record_request_reviewed_by")
}

model training_result {
  result_id                                                                                BigInt                     @id(map: "PK_training_result") @default(autoincrement())
  enrollment_id                                                                            BigInt                     @unique(map: "UX_RC2_training_result_enrollment_id")
  official_pre_submission_id                                                               BigInt?
  pre_score                                                                                Decimal?                   @db.Decimal(10, 2)
  official_post_submission_id                                                              BigInt?
  post_score                                                                               Decimal?                   @db.Decimal(10, 2)
  completion_status                                                                        String                     @db.VarChar(20)
  completed_at                                                                             DateTime?
  valid_until                                                                              DateTime?                  @db.Date
  certificate_no                                                                           String?                    @unique(map: "UX_RC2_training_result_certificate_no_not_null") @db.NVarChar(100)
  training_certificate_file                                                                training_certificate_file?
  training_enrollment                                                                      training_enrollment        @relation(fields: [enrollment_id], references: [enrollment_id], onUpdate: NoAction, map: "FK_V6F076_training_result_enrollment_id")
  assessment_submission_training_result_official_post_submission_idToassessment_submission assessment_submission?     @relation("training_result_official_post_submission_idToassessment_submission", fields: [official_post_submission_id], references: [submission_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F077_training_result_official_post_submission_id")
  assessment_submission_training_result_official_pre_submission_idToassessment_submission  assessment_submission?     @relation("training_result_official_pre_submission_idToassessment_submission", fields: [official_pre_submission_id], references: [submission_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F078_training_result_official_pre_submission_id")
}

