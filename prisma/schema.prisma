generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "sqlserver"
}

model announcement {
  announcement_id BigInt       @id(map: "PK_announcement") @default(autoincrement())
  company_id      BigInt?
  target_role     String       @default("N'ALL'", map: "DF_announcement_target_role") @db.NVarChar(30)
  title           String       @db.NVarChar(255)
  content         String       @db.NVarChar(Max)
  publish_at      DateTime     @default(dbgenerated("sysdatetime()"), map: "DF_announcement_publish_at")
  status          String       @default("N'PUBLISHED'", map: "DF_announcement_status") @db.NVarChar(20)
  created_by      BigInt
  company         company?     @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_announcement_company_company_id")
  user_account    user_account @relation(fields: [created_by], references: [user_id], onUpdate: NoAction, map: "FK_announcement_user_account_created_by")

  @@index([company_id], map: "IX_announcement_company_id")
  @@index([created_by], map: "IX_announcement_created_by")
}

model assessment {
  assessment_id                                                      BigInt                  @id(map: "PK_assessment") @default(autoincrement())
  assessment_series_id                                               BigInt
  assessment_code                                                    String?                 @db.NVarChar(50)
  version_no                                                         Int
  version_note                                                       String?                 @db.NVarChar(500)
  instructions                                                       String?
  passing_score_percent                                              Decimal                 @default(0, map: "DF_assessment_passing_score_percent") @db.Decimal(5, 2)
  time_limit_minutes                                                 Int?
  status                                                             String                  @default("DRAFT", map: "DF_assessment_status") @db.VarChar(10)
  created_by                                                         BigInt
  created_at                                                         DateTime                @default(dbgenerated("sysdatetime()"), map: "DF_assessment_created_at")
  updated_by                                                         BigInt?
  updated_at                                                         DateTime?
  assessment_series                                                  assessment_series       @relation(fields: [assessment_series_id], references: [assessment_series_id], onUpdate: NoAction, map: "FK_V6F034_assessment_assessment_series_id")
  user_account_assessment_created_byTouser_account                   user_account            @relation("assessment_created_byTouser_account", fields: [created_by], references: [user_id], onUpdate: NoAction, map: "FK_V6F035_assessment_created_by")
  user_account_assessment_updated_byTouser_account                   user_account?           @relation("assessment_updated_byTouser_account", fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F036_assessment_updated_by")
  assessment_question                                                assessment_question[]
  assessment_submission                                              assessment_submission[]
  course_course_post_assessment_idToassessment                       course[]                @relation("course_post_assessment_idToassessment")
  course_course_pre_assessment_idToassessment                        course[]                @relation("course_pre_assessment_idToassessment")
  training_plan_oap_training_plan_oap_post_assessment_idToassessment training_plan_oap[]     @relation("training_plan_oap_post_assessment_idToassessment")
  training_plan_oap_training_plan_oap_pre_assessment_idToassessment  training_plan_oap[]     @relation("training_plan_oap_pre_assessment_idToassessment")
  training_plan_post_assessment                                      training_plan[]         @relation("training_plan_post_assessment_idToassessment")
  training_plan_pre_assessment                                       training_plan[]         @relation("training_plan_pre_assessment_idToassessment")

  @@unique([assessment_series_id, version_no], map: "UQ_assessment_series_version")
}

model assessment_answer {
  answer_id             BigInt                @id(map: "PK_assessment_answer") @default(autoincrement())
  submission_id         BigInt
  question_id           BigInt
  choice_id             BigInt?
  answer_text           String?               @db.NVarChar(Max)
  is_correct            Boolean?
  score_awarded         Decimal?              @db.Decimal(8, 2)
  review_status         String                @default("NOT_REQUIRED", map: "DF_assessment_answer_review_status") @db.VarChar(20)
  review_comment        String?
  reviewed_by           BigInt?
  reviewed_at           DateTime?
  assessment_choice     assessment_choice?    @relation(fields: [choice_id], references: [choice_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F072_assessment_answer_choice_id")
  assessment_question   assessment_question   @relation(fields: [question_id], references: [question_id], onUpdate: NoAction, map: "FK_V6F073_assessment_answer_question_id")
  user_account          user_account?         @relation(fields: [reviewed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F074_assessment_answer_reviewed_by")
  assessment_submission assessment_submission @relation(fields: [submission_id], references: [submission_id], onDelete: Cascade, onUpdate: NoAction, map: "FK_V6F075_assessment_answer_submission_id")
}

model assessment_choice {
  choice_id           BigInt              @id(map: "PK_assessment_choice") @default(autoincrement())
  question_id         BigInt
  choice_order        Int
  choice_text         String
  is_correct          Boolean             @default(false, map: "DF_assessment_choice_is_correct")
  option_score        Decimal             @default(0.00, map: "DF_assessment_choice_option_score") @db.Decimal(8, 2)
  assessment_answer   assessment_answer[]
  assessment_question assessment_question @relation(fields: [question_id], references: [question_id], onDelete: Cascade, onUpdate: NoAction, map: "FK_V6F038_assessment_choice_question_id")

  @@unique([question_id, choice_order], map: "UQ_assessment_choice_order")
}

model assessment_question {
  question_id       BigInt              @id(map: "PK_assessment_question") @default(autoincrement())
  assessment_id     BigInt
  question_order    Int
  question_text     String              @db.NVarChar(Max)
  question_type     String              @db.VarChar(30)
  question_score    Decimal             @default(1.00, map: "DF_assessment_question_question_score") @db.Decimal(8, 2)
  is_required       Boolean             @default(true, map: "DF_assessment_question_is_required")
  assessment_answer assessment_answer[]
  assessment_choice assessment_choice[]
  assessment        assessment          @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade, onUpdate: NoAction, map: "FK_V6F037_assessment_question_assessment_id")

  @@unique([assessment_id, question_order], map: "UQ_assessment_question_order")
}

model assessment_series {
  assessment_series_id                                    BigInt        @id(map: "PK_assessment_series") @default(autoincrement())
  company_id                                              BigInt?
  series_code                                             String        @unique(map: "UX_RC2_assessment_series_series_code") @db.NVarChar(50)
  series_name                                             String        @db.NVarChar(255)
  series_name_normalized                                  String        @unique(map: "UX_RC2_assessment_series_series_name_normalized") @db.NVarChar(255)
  purpose                                                 String        @db.VarChar(20)
  last_version_no                                         Int           @default(0, map: "DF_assessment_series_last_version_no")
  created_by                                              BigInt
  created_at                                              DateTime      @default(dbgenerated("sysdatetime()"), map: "DF_assessment_series_created_at")
  updated_by                                              BigInt?
  updated_at                                              DateTime?
  assessment                                              assessment[]
  company                                                 company?      @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F031_assessment_series_company_id")
  user_account_assessment_series_created_byTouser_account user_account  @relation("assessment_series_created_byTouser_account", fields: [created_by], references: [user_id], onUpdate: NoAction, map: "FK_V6F032_assessment_series_created_by")
  user_account_assessment_series_updated_byTouser_account user_account? @relation("assessment_series_updated_byTouser_account", fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F033_assessment_series_updated_by")
}

model assessment_submission {
  submission_id                                                                      BigInt              @id(map: "PK_assessment_submission") @default(autoincrement())
  enrollment_id                                                                      BigInt
  assessment_id                                                                      BigInt
  assessment_stage                                                                   String              @db.VarChar(20)
  attempt_no                                                                         Int
  started_at                                                                         DateTime            @default(dbgenerated("sysdatetime()"), map: "DF_assessment_submission_started_at")
  submitted_at                                                                       DateTime?
  score                                                                              Decimal?            @db.Decimal(10, 2)
  pass_status                                                                        String              @default("PENDING", map: "DF_assessment_submission_pass_status") @db.VarChar(20)
  status                                                                             String              @default("IN_PROGRESS", map: "DF_assessment_submission_status") @db.VarChar(20)
  grading_status                                                                     String              @default("PENDING_REVIEW", map: "DF_assessment_submission_grading_status") @db.VarChar(20)
  publication_status                                                                 String              @default("UNPUBLISHED", map: "DF_assessment_submission_publication_status") @db.VarChar(20)
  published_by                                                                       BigInt?
  published_at                                                                       DateTime?
  reopened_by                                                                        BigInt?
  reopened_at                                                                        DateTime?
  reopen_reason                                                                      String?
  assessment_answer                                                                  assessment_answer[]
  assessment                                                                         assessment          @relation(fields: [assessment_id], references: [assessment_id], onUpdate: NoAction, map: "FK_V6F068_assessment_submission_assessment_id")
  training_enrollment                                                                training_enrollment @relation(fields: [enrollment_id], references: [enrollment_id], onUpdate: NoAction, map: "FK_V6F069_assessment_submission_enrollment_id")
  user_account_assessment_submission_published_byTouser_account                      user_account?       @relation("assessment_submission_published_byTouser_account", fields: [published_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F070_assessment_submission_published_by")
  user_account_assessment_submission_reopened_byTouser_account                       user_account?       @relation("assessment_submission_reopened_byTouser_account", fields: [reopened_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F071_assessment_submission_reopened_by")
  training_result_training_result_official_post_submission_idToassessment_submission training_result[]   @relation("training_result_official_post_submission_idToassessment_submission")
  training_result_training_result_official_pre_submission_idToassessment_submission  training_result[]   @relation("training_result_official_pre_submission_idToassessment_submission")

  @@unique([enrollment_id, assessment_id, assessment_stage, attempt_no], map: "UQ_assessment_submission_attempt")
}

model attendance {
  attendance_id       BigInt              @id(map: "PK_attendance") @default(autoincrement())
  enrollment_id       BigInt              @unique(map: "UQ_attendance_enrollment_id")
  check_in_at         DateTime?
  check_out_at        DateTime?
  attendance_status   String              @db.NVarChar(20)
  recorded_by         BigInt?
  attendance_method   String              @default("N'QR'", map: "DF_attendance_attendance_method") @db.NVarChar(20)
  remark              String?             @db.NVarChar(500)
  user_account        user_account?       @relation(fields: [recorded_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_attendance_user_account_recorded_by")
  training_enrollment training_enrollment @relation(fields: [enrollment_id], references: [enrollment_id], onUpdate: NoAction, map: "FK_V6F064_attendance_enrollment_id")

  @@index([recorded_by], map: "IX_attendance_recorded_by")
}

model certificate_import_batch {
  certificate_import_batch_id                                      BigInt                      @id(map: "PK_certificate_import_batch") @default(autoincrement())
  plan_id                                                          BigInt
  import_batch_code                                                String                      @unique(map: "UQ_certificate_import_batch_code") @db.NVarChar(50)
  total_file_count                                                 Int                         @default(0, map: "DF_certificate_import_batch_total_file_count")
  matched_file_count                                               Int                         @default(0, map: "DF_certificate_import_batch_matched_file_count")
  failed_file_count                                                Int                         @default(0, map: "DF_certificate_import_batch_failed_file_count")
  pending_file_count                                               Int                         @default(0, map: "DF_certificate_import_batch_pending_file_count")
  import_status                                                    String                      @default("N'UPLOADED'", map: "DF_certificate_import_batch_import_status") @db.NVarChar(30)
  imported_by                                                      BigInt
  imported_at                                                      DateTime                    @default(dbgenerated("sysdatetime()"), map: "DF_certificate_import_batch_imported_at")
  confirmed_by                                                     BigInt?
  confirmed_at                                                     DateTime?
  remark                                                           String?                     @db.NVarChar(500)
  created_at                                                       DateTime                    @default(dbgenerated("sysdatetime()"), map: "DF_certificate_import_batch_created_at")
  updated_at                                                       DateTime?
  user_account_certificate_import_batch_confirmed_byTouser_account user_account?               @relation("certificate_import_batch_confirmed_byTouser_account", fields: [confirmed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_certificate_import_batch_confirmed_by_user_account")
  user_account_certificate_import_batch_imported_byTouser_account  user_account                @relation("certificate_import_batch_imported_byTouser_account", fields: [imported_by], references: [user_id], onUpdate: NoAction, map: "FK_certificate_import_batch_imported_by_user_account")
  training_plan                                                    training_plan               @relation(fields: [plan_id], references: [plan_id], onUpdate: NoAction, map: "FK_certificate_import_batch_training_plan")
  training_certificate_file                                        training_certificate_file[]

  @@index([plan_id], map: "IX_certificate_import_batch_plan_id")
}

model company {
  company_id                     BigInt                           @id(map: "PK_company") @default(autoincrement())
  company_code                   String                           @unique(map: "UQ_company_company_code") @db.NVarChar(30)
  company_name_th                String                           @db.NVarChar(255)
  company_name_en                String?                          @db.NVarChar(255)
  remark                         String?                          @db.NVarChar(500)
  status                         String                           @default("N'ACTIVE'", map: "DF_company_status") @db.NVarChar(20)
  announcement                   announcement[]
  assessment_series              assessment_series[]
  company_department_mapping     company_department_mapping[]
  company_division_mapping       company_division_mapping[]
  company_function_mapping       company_function_mapping[]
  company_section_mapping        company_section_mapping[]
  course                         course[]
  course_standard                course_standard[]
  course_standard_target_company course_standard_target_company[]
  employee                       employee[]
  evaluation_form                evaluation_form[]
  training_need_request          training_need_request[]
  training_plan_oap              training_plan_oap[]
  training_record_request        training_record_request[]
  user_account                   user_account[]
}

model company_function_mapping {
  function_mapping_id   BigInt                @id(map: "PK_company_function_mapping") @default(autoincrement())
  company_id            BigInt
  plant_function_code   String                @db.NVarChar(50)
  plant_function_name   String                @db.NVarChar(255)
  function_id           BigInt
  status                String                @default("N'ACTIVE'", map: "DF_company_function_mapping_status") @db.NVarChar(20)
  company               company               @relation(fields: [company_id], references: [company_id], onUpdate: NoAction, map: "FK_company_function_mapping_company_company_id")
  organization_function organization_function @relation(fields: [function_id], references: [function_id], onUpdate: NoAction, map: "FK_company_function_mapping_organization_function_function_id")

  @@unique([company_id, plant_function_code], map: "UQ_company_function_mapping_company_id_plant_function_code")
  @@index([function_id], map: "IX_company_function_mapping_function_id")
}

model course {
  course_id                                        BigInt                   @id(map: "PK_course") @default(autoincrement())
  company_id                                       BigInt?
  course_type_id                                   BigInt
  course_group_id                                  BigInt
  course_code                                      String                   @unique(map: "UX_RC2_course_course_code") @db.VarChar(20)
  course_name                                      String                   @db.NVarChar(255)
  course_name_normalized                           String                   @unique(map: "UX_course_central_name_normalized", where: raw("([company_id] IS NULL)")) @db.NVarChar(255)
  description                                      String?
  objective                                        String?                  @db.NVarChar(Max)
  learning_content                                 String?                  @db.NVarChar(Max)
  duration_hours                                   Int
  validity_months                                  Int?
  pre_assessment_id                                BigInt?
  post_assessment_id                               BigInt?
  evaluation_form_id                               BigInt?
  status                                           String                   @default("ACTIVE", map: "DF_course_status") @db.VarChar(10)
  created_by                                       BigInt
  created_at                                       DateTime                 @default(dbgenerated("sysdatetime()"), map: "DF_course_created_at")
  updated_by                                       BigInt?
  updated_at                                       DateTime?
  course_name_en                                   String?                  @db.NVarChar(255)
  target_group                                     String?                  @db.NVarChar(Max)
  methodology                                      String?                  @db.NVarChar(Max)
  evaluation_form_after_30day_id                   BigInt?
  pre_test_link                                    String?                  @db.NVarChar(2048)
  post_test_link                                   String?                  @db.NVarChar(2048)
  evaluation_link                                  String?                  @db.NVarChar(2048)
  evaluation_after_30day_link                      String?                  @db.NVarChar(2048)
  evaluation_form_after_30day                      evaluation_form?         @relation("CourseEvaluationFormAfter30Day", fields: [evaluation_form_after_30day_id], references: [evaluation_form_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_course_evaluation_form_after_30day_id")
  company                                          company?                 @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F014_course_company_id")
  course_group                                     course_group             @relation(fields: [course_group_id], references: [course_group_id], onUpdate: NoAction, map: "FK_V6F015_course_course_group_id")
  course_type                                      course_type              @relation(fields: [course_type_id], references: [course_type_id], onUpdate: NoAction, map: "FK_V6F016_course_course_type_id")
  user_account_course_created_byTouser_account     user_account             @relation("course_created_byTouser_account", fields: [created_by], references: [user_id], onUpdate: NoAction, map: "FK_V6F017_course_created_by")
  evaluation_form                                  evaluation_form?         @relation("CourseEvaluationForm", fields: [evaluation_form_id], references: [evaluation_form_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F018_course_evaluation_form_id")
  assessment_course_post_assessment_idToassessment assessment?              @relation("course_post_assessment_idToassessment", fields: [post_assessment_id], references: [assessment_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F019_course_post_assessment_id")
  assessment_course_pre_assessment_idToassessment  assessment?              @relation("course_pre_assessment_idToassessment", fields: [pre_assessment_id], references: [assessment_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F020_course_pre_assessment_id")
  user_account_course_updated_byTouser_account     user_account?            @relation("course_updated_byTouser_account", fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F021_course_updated_by")
  course_standard_course                           course_standard_course[]
  training_need_request                            training_need_request[]
  training_plan_oap                                training_plan_oap[]
  prerequisites                                    course_prerequisite[]    @relation("course_prerequisite_course")
  required_by                                      course_prerequisite[]    @relation("course_prerequisite_required_by")

  @@unique([company_id, course_name_normalized], map: "UX_course_company_name_normalized", where: raw("([company_id] IS NOT NULL)"))
}

/// Continuation courses: one row means course_id can only be registered for once
/// prerequisite_course_id has been completed. See prisma/migrations/31_Add_Course_Prerequisite.sql
/// for why this is a join table and why only one of the two foreign keys cascades.
///
/// Hand-written rather than introspected, so the relation fields have readable names. A later
/// `prisma db pull` will rename them to the generated form and break the repository - check the
/// diff on this model if you run one.
model course_prerequisite {
  course_prerequisite_id BigInt   @id(map: "PK_course_prerequisite") @default(autoincrement())
  course_id              BigInt
  prerequisite_course_id BigInt
  created_at             DateTime @default(dbgenerated("sysdatetime()"), map: "DF_course_prerequisite_created_at")
  course                 course   @relation("course_prerequisite_course", fields: [course_id], references: [course_id], onDelete: Cascade, onUpdate: NoAction, map: "FK_course_prerequisite_course_id")
  prerequisite_course    course   @relation("course_prerequisite_required_by", fields: [prerequisite_course_id], references: [course_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_course_prerequisite_prerequisite_course_id")

  @@unique([course_id, prerequisite_course_id], map: "UQ_course_prerequisite")
  @@index([prerequisite_course_id], map: "IX_course_prerequisite_prerequisite_course_id")
}

model course_group {
  course_group_id                                    BigInt        @id(map: "PK_course_group") @default(autoincrement())
  course_group_code                                  String        @unique(map: "UX_RC2_course_group_course_group_code") @db.Char(2)
  course_group_name                                  String        @unique(map: "UX_RC2_course_group_course_group_name") @db.NVarChar(255)
  last_course_number                                 Int           @default(0, map: "DF_course_group_last_course_number")
  status                                             String        @default("ACTIVE", map: "DF_course_group_status") @db.VarChar(10)
  created_by                                         BigInt
  created_at                                         DateTime      @default(dbgenerated("sysdatetime()"), map: "DF_course_group_created_at")
  updated_by                                         BigInt?
  updated_at                                         DateTime?
  course_group_name_normalized                       String        @unique(map: "UX_RC2_course_group_course_group_name_normalized") @db.NVarChar(255)
  course                                             course[]
  user_account_course_group_created_byTouser_account user_account  @relation("course_group_created_byTouser_account", fields: [created_by], references: [user_id], onUpdate: NoAction, map: "FK_V6F012_course_group_created_by")
  user_account_course_group_updated_byTouser_account user_account? @relation("course_group_updated_byTouser_account", fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F013_course_group_updated_by")
}

model course_standard {
  standard_id                                           BigInt                   @id(map: "PK_course_standard") @default(autoincrement())
  company_id                                            BigInt?
  standard_year                                         Int                      @unique(map: "UX_course_standard_central_year", where: raw("([company_id] IS NULL)")) @db.SmallInt
  standard_code                                         String                   @unique(map: "UX_RC2_course_standard_standard_code") @db.NVarChar(50)
  standard_name                                         String                   @db.NVarChar(255)
  description                                           String?
  status                                                String                   @default("ACTIVE", map: "DF_course_standard_status") @db.VarChar(10)
  created_by                                            BigInt
  created_at                                            DateTime                 @default(dbgenerated("sysdatetime()"), map: "DF_course_standard_created_at")
  updated_at                                            DateTime?
  updated_by                                            BigInt?
  company                                               company?                 @relation(fields: [company_id], references: [company_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F022_course_standard_company_id")
  user_account_course_standard_created_byTouser_account user_account             @relation("course_standard_created_byTouser_account", fields: [created_by], references: [user_id], onUpdate: NoAction, map: "FK_V6F023_course_standard_created_by")
  user_account_course_standard_updated_byTouser_account user_account?            @relation("course_standard_updated_byTouser_account", fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_V6F024_course_standard_updated_by")
  course_standard_course                                course_standard_course[]

  @@unique([company_id, standard_year], map: "UX_course_standard_company_year", where: raw("([company_id] IS NOT NULL)"))
}

model course_standard_course {
  standard_course_id              BigInt                            @id(map: "PK_course_standard_course") @default(autoincrement())
  standard_id                     BigInt
  course_id                       BigInt
  created_at                      DateTime                          @default(dbgenerated("sysdatetime()"), map: "DF_course_standard_course_created_at")
  function_id                     BigInt?
  division_id                     BigInt?
  department_id                   BigInt?
